# Everest Textile OS - Backend Environment Configuration Example
PROJECT_NAME="Everest Textile OS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security (Minimum 32 characters in production)
SECRET_KEY="generate-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# For local PostgreSQL: postgresql+psycopg2://postgres:<password>@localhost:5432/everest_textile_db
DATABASE_URL="postgresql+psycopg2://postgres:your_password_here@localhost:5432/everest_textile_db"

# CORS Settings (Explicit allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Virtual Factory Simulator Integration (Minimum 16 characters in production)
SIMULATOR_SHARED_SECRET="generate-a-secure-simulator-secret-minimum-16-chars"

# Optional Gemini AI API Key
GEMINI_API_KEY=""
