# Everest Textile OS - Backend Environment Configuration
PROJECT_NAME="Everest Textile OS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/everest_textile_db
# For Local SQLite testing / offline fallback: sqlite:///./everest_textile.db
DATABASE_URL="sqlite:///./everest_textile.db"

# CORS Settings (Member 1 frontend)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Virtual Factory Simulator Integration (Member 3)
SIMULATOR_SHARED_SECRET="simulator-dev-secret-key-2026"
